@model Projeto_Liga_Tabajara.Models.Time

@{
    ViewBag.Title = "Editar Time";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* Container centralizado */
    .form-container {
        max-width: 600px;
        margin: 2rem auto;
        padding: 1.5rem;
        background-color: #f8f9fa;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

        /* Cabeçalho */
        .form-container h2 {
            text-align: center;
            margin-bottom: 1rem;
            color: #005f99;
        }

        /* Campos do formulário */
        .form-container .form-group {
            display: flex;
            flex-direction: column;
            align-items: center; /* centraliza horizontalmente */
            margin-bottom: 1rem;
        }

        .form-container label {
            margin-bottom: 0.5rem;
            font-weight: 600;
            text-align: center; /* centraliza o texto do label */
        }

        .form-container .form-control {
            width: 80%; /* ocupa 80% da largura do container */
            height: 2.5rem;
            padding: 0.5rem;
            font-size: 1rem;
            border: 1px solid #ced4da;
            border-radius: 4px;
            margin: 0;
        }

        /* Botão de submit */
        .form-container .btn-submit {
            display: block;
            width: 50%;
            margin: 1.5rem auto 0;
            padding: 0.6rem;
            font-size: 1rem;
            background-color: #005f99;
            color: #fff;
            border: none;
            border-radius: 4px;
        }

            .form-container .btn-submit:hover {
                background-color: #004070;
            }

        /* Link de voltar */
        .form-container .back-link {
            display: block;
            text-align: center;
            margin-top: 1rem;
            color: #005f99;
        }
</style>

<div class="form-container">
    <h2>Editar Time</h2>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.Id)
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <!-- Nome -->
        <div class="form-group">
            @Html.LabelFor(m => m.Nome)
            @Html.EditorFor(m => m.Nome, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(m => m.Nome, "", new { @class = "text-danger" })
        </div>

        <!-- Cidade -->
        <div class="form-group">
            @Html.LabelFor(m => m.Cidade)
            @Html.EditorFor(m => m.Cidade, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(m => m.Cidade, "", new { @class = "text-danger" })
        </div>

        <!-- Estado -->
        <div class="form-group">
            @Html.LabelFor(m => m.Estado)
            @Html.EditorFor(m => m.Estado, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(m => m.Estado, "", new { @class = "text-danger" })
        </div>

        <!-- Ano de Fundação -->
        <div class="form-group">
            @Html.LabelFor(m => m.AnoFundacao, "Ano de Fundação")
            @Html.EditorFor(m => m.AnoFundacao, new { htmlAttributes = new { @class = "form-control", placeholder = "YYYY" } })
            @Html.ValidationMessageFor(m => m.AnoFundacao, "", new { @class = "text-danger" })
        </div>

        <!-- Estádio -->
        <div class="form-group">
            @Html.LabelFor(m => m.Estadio)
            @Html.EditorFor(m => m.Estadio, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(m => m.Estadio, "", new { @class = "text-danger" })
        </div>

        <!-- Capacidade do Estádio -->
        <div class="form-group">
            @Html.LabelFor(m => m.CapacidadeEstadio, "Capacidade Estádio")
            @Html.EditorFor(m => m.CapacidadeEstadio, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(m => m.CapacidadeEstadio, "", new { @class = "text-danger" })
        </div>

        <!-- Cor Uniforme Primária -->
        <div class="form-group">
            @Html.LabelFor(m => m.CorUniformePrimaria, "Cor Uniforme Primária")
            @Html.EditorFor(m => m.CorUniformePrimaria, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(m => m.CorUniformePrimaria, "", new { @class = "text-danger" })
        </div>

        <!-- Cor Uniforme Secundária -->
        <div class="form-group">
            @Html.LabelFor(m => m.CorUniformeSecundaria, "Cor Uniforme Secundária")
            @Html.EditorFor(m => m.CorUniformeSecundaria, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(m => m.CorUniformeSecundaria, "", new { @class = "text-danger" })
        </div>

        <input type="submit" value="Salvar Alterações" class="btn-submit" />
    }

    @Html.ActionLink("Voltar à Lista", "Index", null, new { @class = "back-link" })
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}