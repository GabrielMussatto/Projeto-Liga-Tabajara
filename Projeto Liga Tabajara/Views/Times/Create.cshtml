@model Projeto_Liga_Tabajara.Models.Time

@{
    ViewBag.Title = "Create Time";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* Container centralizado e largura fixa */
    .form-container {
        max-width: 600px;
        margin: 2rem auto;
        padding: 1.5rem;
        background-color: #f8f9fa;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

        /* Cabeçalho do formulário */
        .form-container h2 {
            text-align: center;
            margin-bottom: 1rem;
            color: #005f99;
        }

        /* Campos uniformes e centralizados */
        .form-container .form-group {
            display: flex;
            flex-direction: column;
            align-items: center; /* centraliza horizontalmente */
            margin-bottom: 1rem;
        }

        .form-container label {
            margin-bottom: 0.5rem;
            font-weight: 600;
            text-align: center; /* centraliza o texto do label */
        }

        .form-container .form-control {
            width: 80%; /* reduz largura para 80% do container */
            height: 2.5rem;
            padding: 0.5rem;
            font-size: 1rem;
            border: 1px solid #ced4da;
            border-radius: 4px;
            margin: 0; /* remove margens automáticas */
        }

        /* Botão centralizado */
        .form-container .btn-submit {
            display: block;
            width: 50%;
            margin: 1.5rem auto 0;
            padding: 0.6rem;
            font-size: 1rem;
            background-color: #005f99;
            color: #fff;
            border: none;
            border-radius: 4px;
        }

            .form-container .btn-submit:hover {
                background-color: #004070;
            }

        /* Link de voltar */
        .form-container .back-link {
            display: block;
            text-align: center;
            margin-top: 1rem;
            color: #005f99;
        }
</style>

<div class="form-container">
    <h2>Cadastrar Time</h2>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <!-- Nome -->
        <div class="form-group">
            @Html.LabelFor(model => model.Nome)
            @Html.EditorFor(model => model.Nome, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.Nome, "", new { @class = "text-danger" })
        </div>

        <!-- Cidade -->
        <div class="form-group">
            @Html.LabelFor(model => model.Cidade)
            @Html.EditorFor(model => model.Cidade, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.Cidade, "", new { @class = "text-danger" })
        </div>

        <!-- Estado -->
        <div class="form-group">
            @Html.LabelFor(model => model.Estado)
            @Html.EditorFor(model => model.Estado, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.Estado, "", new { @class = "text-danger" })
        </div>

        <!-- Ano de Fundação -->
        <div class="form-group">
            @Html.LabelFor(model => model.AnoFundacao)
            @Html.EditorFor(model => model.AnoFundacao, new { htmlAttributes = new { @class = "form-control", placeholder = "YYYY" } })
            @Html.ValidationMessageFor(model => model.AnoFundacao, "", new { @class = "text-danger" })
        </div>

        <!-- Estádio -->
        <div class="form-group">
            @Html.LabelFor(model => model.Estadio)
            @Html.EditorFor(model => model.Estadio, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.Estadio, "", new { @class = "text-danger" })
        </div>

        <!-- Capacidade do Estádio -->
        <div class="form-group">
            @Html.LabelFor(model => model.CapacidadeEstadio)
            @Html.EditorFor(model => model.CapacidadeEstadio, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.CapacidadeEstadio, "", new { @class = "text-danger" })
        </div>

        <!-- Cor do Uniforme Primária -->
        <div class="form-group">
            @Html.LabelFor(model => model.CorUniformePrimaria)
            @Html.EditorFor(model => model.CorUniformePrimaria, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.CorUniformePrimaria, "", new { @class = "text-danger" })
        </div>

        <!-- Cor do Uniforme Secundária -->
        <div class="form-group">
            @Html.LabelFor(model => model.CorUniformeSecundaria)
            @Html.EditorFor(model => model.CorUniformeSecundaria, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.CorUniformeSecundaria, "", new { @class = "text-danger" })
        </div>

        <input type="submit" value="Cadastrar Time" class="btn-submit" />
    }

    @Html.ActionLink("Voltar à lista", "Index", null, new { @class = "back-link" })
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}