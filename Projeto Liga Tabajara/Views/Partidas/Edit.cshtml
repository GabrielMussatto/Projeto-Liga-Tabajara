@model Projeto_Liga_Tabajara.Models.Partida

@{
    ViewBag.Title = "Edit Partida";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Edit Partida</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.Id)

    <div class="form-horizontal">
        <h4>Editar Agendamento de Partida</h4>
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <!-- Data da Partida -->
        <div class="form-group">
            @Html.LabelFor(model => model.Data, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.Data, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Data, "", new { @class = "text-danger" })
            </div>
        </div>

        <!-- Rodada -->
        <div class="form-group">
            @Html.LabelFor(model => model.Rodada, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.Rodada, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Rodada, "", new { @class = "text-danger" })
            </div>
        </div>

        <!-- Estádio -->
        <div class="form-group">
            @Html.LabelFor(model => model.Estadio, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.Estadio, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Estadio, "", new { @class = "text-danger" })
            </div>
        </div>

        <!-- Time Mandante -->
        <div class="form-group">
            @Html.Label("Time Mandante", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.DropDownList("TimeMandanteId", (SelectList)ViewBag.TimeMandanteId, "Select Time", new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.TimeMandanteId, "", new { @class = "text-danger" })
            </div>
        </div>

        <!-- Time Visitante -->
        <div class="form-group">
            @Html.Label("Time Visitante", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.DropDownList("TimeVisitanteId", (SelectList)ViewBag.TimeVisitanteId, "Select Time", new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.TimeVisitanteId, "", new { @class = "text-danger" })
            </div>
        </div>

        @* Se desejar, você pode incluir campos para atualização dos gols, mas isso pode ser feito via ação específica. *@

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Save" class="btn btn-default" />
            </div>
        </div>
    </div>
}

<div>
    @Html.ActionLink("Back to List", "Index")
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}