@{
    ViewBag.Title = "Gerar Partidas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Gerar Calendário de Partidas</h2>

@if (TempData["Erro"] != null)
{
    <div class="alert alert-danger">@TempData["Erro"]</div>
}
@if (TempData["Mensagem"] != null)
{
    <div class="alert alert-success">@TempData["Mensagem"]</div>
}

@using (Html.BeginForm("GerarPartidasConfirmed", "Partidas", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    <p>
        <button type="submit" class="btn btn-primary">
            Confirmar e Gerar 38 Rodadas
        </button>
        @Html.ActionLink("Voltar", "Index", null, new { @class = "btn btn-default" })
    </p>
}