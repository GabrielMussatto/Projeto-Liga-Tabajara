@model Projeto_Liga_Tabajara.Models.ComissaoTecnica

@{
    ViewBag.Title = "Editar Comissão Técnica";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* Container centralizado para o formulário */
    .form-container {
        max-width: 600px;
        margin: 2rem auto;
        padding: 1.5rem;
        background-color: #f8f9fa;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

        /* Título */
        .form-container h2 {
            text-align: center;
            margin-bottom: 1rem;
            color: #005f99;
        }

        /* Cada grupo de campo */
        .form-container .form-group {
            display: flex;
            flex-direction: column;
            align-items: center;
            margin-bottom: 1rem;
        }

        .form-container label {
            margin-bottom: 0.5rem;
            font-weight: 600;
            text-align: center;
        }

        .form-container .form-control {
            width: 80%;
            height: 2.5rem;
            padding: 0.5rem;
            font-size: 1rem;
            border: 1px solid #ced4da;
            border-radius: 4px;
            margin: 0;
        }

        /* Botão de salvar */
        .form-container .btn-submit {
            display: block;
            width: 50%;
            margin: 1.5rem auto 0;
            padding: 0.6rem;
            font-size: 1rem;
            background-color: #005f99;
            color: #fff;
            border: none;
            border-radius: 4px;
        }

            .form-container .btn-submit:hover {
                background-color: #004070;
            }

        /* Link de voltar */
        .form-container .back-link {
            display: block;
            text-align: center;
            margin-top: 1rem;
            color: #005f99;
        }
</style>

<div class="form-container">
    <h2>Editar Comissão Técnica</h2>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.Id)
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <!-- Nome -->
        <div class="form-group">
            @Html.LabelFor(m => m.Nome)
            @Html.EditorFor(m => m.Nome, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(m => m.Nome, "", new { @class = "text-danger" })
        </div>

        <!-- Cargo -->
        <div class="form-group">
            @Html.LabelFor(m => m.Cargo)
            @Html.EnumDropDownListFor(m => m.Cargo, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.Cargo, "", new { @class = "text-danger" })
        </div>

        <!-- Data de Nascimento -->
        <div class="form-group">
            @Html.LabelFor(m => m.DataNascimento, "Data de Nascimento")
            @Html.EditorFor(m => m.DataNascimento, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(m => m.DataNascimento, "", new { @class = "text-danger" })
        </div>

        <!-- Time -->
        <div class="form-group">
            @Html.LabelFor(m => m.TimeId, "Time")
            @Html.DropDownList("TimeId", (SelectList)ViewBag.TimeId, "Selecione o Time", new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.TimeId, "", new { @class = "text-danger" })
        </div>

        <input type="submit" value="Salvar Alterações" class="btn-submit" />
    }

    @Html.ActionLink("Voltar à Lista", "Index", null, new { @class = "back-link" })
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}