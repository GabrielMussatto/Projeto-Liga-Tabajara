@model Projeto_Liga_Tabajara.Models.ComissaoTecnica

@{
    ViewBag.Title = "Excluir Comissão Técnica";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .delete-container {
        max-width: 600px;
        margin: 2rem auto;
        padding: 1.5rem;
        background-color: #f8f9fa;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

        .delete-container h2 {
            text-align: center;
            margin-bottom: 1rem;
            color: #c82333;
        }

        .delete-container p {
            text-align: center;
            font-size: 1.1rem;
            margin-bottom: 1.5rem;
            color: #333;
        }

        .delete-container dl dt {
            font-weight: 600;
            margin-top: 1rem;
            color: #555;
        }

        .delete-container dl dd {
            margin: 0 0 .75rem 0;
            padding-left: .5rem;
            color: #333;
        }

    .action-buttons {
        text-align: center;
        margin-top: 1.5rem;
    }

        .action-buttons .btn {
            margin: 0 .5rem;
            padding: .5rem 1.2rem;
            font-size: .9rem;
        }
</style>

<div class="delete-container">
    <h2>Excluir Comissão Técnica</h2>
    <p>Tem certeza de que deseja excluir este profissional?</p>

    <dl>
        <dt>@Html.DisplayNameFor(m => m.Time.Nome)</dt>
        <dd>@Html.DisplayFor(m => m.Time.Nome)</dd>

        <dt>@Html.DisplayNameFor(m => m.Nome)</dt>
        <dd>@Html.DisplayFor(m => m.Nome)</dd>

        <dt>@Html.DisplayNameFor(m => m.Cargo)</dt>
        <dd>@Html.DisplayFor(m => m.Cargo)</dd>

        <dt>@Html.DisplayNameFor(m => m.DataNascimento)</dt>
        <dd>@Html.DisplayFor(m => m.DataNascimento)</dd>
    </dl>

    <div class="action-buttons">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            <input type="submit" value="Excluir" class="btn btn-danger" />
            @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-secondary" })
        }
    </div>
</div>